---
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../utils/posts';
import { withBase } from '../utils/paths';

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 5);
---

<BaseLayout>
  <section class="hero container">
    <div class="hero-content">
      <p class="eyebrow">Tech & Life</p>
      <h1>
        写代码，
        <br />
        也认真生活。
      </h1>
      <p class="hero-description">
        你好，我是
        Junhua。这里记录技术实践、学习思考，也收藏日常生活中值得留下的片段。
      </p>
      <div class="hero-actions">
        <a class="button" href={withBase('/posts/')}>
          开始阅读
        </a>
        <a class="text-link" href={withBase('/about/')}>
          了解更多 →
        </a>
      </div>
    </div>
  </section>

  <section class="content-section container" aria-labelledby="recent-posts">
    <div class="section-heading">
      <h2 id="recent-posts">最近更新</h2>
      <a class="text-link" href={withBase('/posts/')}>
        全部文章 →
      </a>
    </div>
    <div class="post-list">
      {recentPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
