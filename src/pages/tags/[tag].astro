---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, type BlogPost } from '../../utils/posts';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  posts: BlogPost[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`标签“${tag}”下的全部文章。`}>
  <div class="container">
    <header class="page-intro">
      <a class="back-link" href={withBase('/tags/')}>
        ← 全部标签
      </a>
      <h1>
        #{tag}
        <span class="post-count">{posts.length} 篇</span>
      </h1>
      <p>这个主题下的全部文章。</p>
    </header>
    <div class="post-list content-section">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
