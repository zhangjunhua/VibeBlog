---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在。">
  <section class="not-found container">
    <p class="eyebrow">404</p>
    <h1>这一页走丢了。</h1>
    <p>链接可能已经改变，也可能从未存在。回到首页继续逛逛吧。</p>
    <a class="button" href={withBase('/')}>
      返回首页
    </a>
  </section>
</BaseLayout>
